# BGAP Data City Environment Configuration
NEXT_PUBLIC_APP_NAME="BGAP Data City"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# BGAP Core Auth & Backend Integration
NEXT_PUBLIC_BGAP_API_URL="http://localhost:8000"
BGAP_AUTH_SECRET="your-bgap-auth-jwt-secret"

# Supabase Database (Shared with BGAP Platform)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# DuckDB WASM Bundles (Can point to local public/ or unpkg CDN)
NEXT_PUBLIC_DUCKDB_WASM_URL="https://cdn.jsdelivr.net/npm/@duckdb/duckdb-wasm@1.29.0/dist/"

# Game Engine Feature Flags
NEXT_PUBLIC_ENABLE_PHYSICS_DEBUG="false"
NEXT_PUBLIC_DEFAULT_GRAPHICS_PROFILE="balanced" # 'low' | 'balanced' | 'high'
